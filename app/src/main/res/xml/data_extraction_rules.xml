<?xml version="1.0" encoding="utf-8"?>
<!--
   A keyboard's files are private: your learned words, clipboard history, stickers and theme photo.
   None of it goes to Google's cloud backup. Moving to a new phone with a cable or Smart Switch
   (device-to-device) still brings it along.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
